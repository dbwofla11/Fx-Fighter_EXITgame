  m_Script: {fileID: 11500000, guid: e156c6d0f00000342bfe5645c848b686, type: 3}
  m_Name: "\uC5D1\uC2DC\uD2B8_\uC601\uC6C5"
  m_EditorClassIdentifier: Assembly-CSharp::StoryBeatSetSO
  beats:
  - background: {fileID: -3373147437577035260, guid: 87b4074a96ccd3f4daef4a9786295023, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uBBF8\uCCE4\uB2E4 \uC9C4\uC9DC... \uC774\uAC70 \uC624\uB298 \uC0C1\uD55C\uAC00\uB97C
      \uBA87 \uBC88\uC744 \uB6AB\uB294 \uAC70\uC57C!!"
  - background: {fileID: -3373147437577035260, guid: 87b4074a96ccd3f4daef4a9786295023, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC5EC\uB7EC\uBD84, \uC81C\uAC00 \uC774 \uCF54\uC778 \uCC98\uC74C \uC18C\uAC1C\uD588\uC744
      \uB54C \uC544\uBB34\uB3C4 \uC548 \uBBFF\uC5C8\uC796\uC544\uC694. \n\uC624\uB298
      \uC800 \uBBFF\uACE0 \uB4E4\uC5B4\uC628 \uC0AC\uB78C \uB2E4 \uC778\uC0DD \uD3C8\uC5B4\uC694!"
  - background: {fileID: -3373147437577035260, guid: 87b4074a96ccd3f4daef4a9786295023, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "(\uCE74\uBA54\uB77C \uBC16\uC5D0\uC11C, \uC544\uBB34\uB3C4 \uBABB \uB4E3\uAC8C)
      ...\uC608\uC815\uB300\uB85C\uB124."
  - background: {fileID: -3028407511065196692, guid: ce3c06a453f545b468da92c885d5fc84, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC774, \uC774\uAC70 \uAC11\uC790\uAE30 \uC65C \uC774\uB798\uC694?!\n\uC800\uB3C4
      \uC9C0\uAE08 \uD328\uB2C9\uC774\uC5D0\uC694, \uC5EC\uB7EC\uBD84! \uC800\uB3C4
      \uBB3C\uB838\uB2E4\uAD6C\uC694!!"
  - background: {fileID: -3028407511065196692, guid: ce3c06a453f545b468da92c885d5fc84, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uBC84\uADF8 \uC544\uB2C8\uC5D0\uC694? \uC774\uAC70 \uBC84\uADF8\uC8E0??\n(
      \uD63C\uC2E0\uC744 \uB2E4\uD574 \uC5F0\uAE30\uD55C\uB2E4 )"
  - background: {fileID: -1084611895696448309, guid: 2f85443d40410fc40995e70d05065365, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC800\uB294... \uC800\uB294 \uC9C4\uC9DC \uBAB0\uB790\uC5B4\uC694. \uC800\uB3C4
      \uC5EC\uB7EC\uBD84\uC774\uB791 \uB611\uAC19\uC774 \uC0B0 \uC0AC\uB78C\uC774\uC5D0\uC694."
  - background: {fileID: -1084611895696448309, guid: 2f85443d40410fc40995e70d05065365, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC81C\uBC1C\uC694... \uC800 \uC880 \uBBFF\uC5B4\uC8FC\uC138\uC694...
      \uC800\uB3C4... \uC800\uB3C4 \uB2E4 \uC783\uC5C8\uB2E4\uAD6C\uC694...\n( \uB354\uC6B1
      \uB354 \uD63C\uC2E0\uC744 \uB2E4\uD574 \uC5F0\uAE30\uD55C\uB2E4 )"
  - background: {fileID: 4513544251747014989, guid: 2c70ece097cbfb84fb79046224abbddc, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uB2E4\uB4E4 \uC9C4\uC9DC \uC798 \uC18D\uC544\uC8FC\uB124. \u314B\u314B\u314B\n"
  - background: {fileID: 4513544251747014989, guid: 2c70ece097cbfb84fb79046224abbddc, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC774\uAC78\uB85C 5\uC5B5, \uB2E4 \uCC44\uC6E0\uB2E4."
  - background: {fileID: -7046376736601078521, guid: fdeadb50d296de9489b9589651c6cbc8, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC5EC\uAE30\uB77C\uBA74 \uC544\uBB34\uB3C4 \uBABB \uCAD2\uC544\uC624\uC9C0
      \u314B\u314B\u314B"
  - background: {fileID: -7046376736601078521, guid: fdeadb50d296de9489b9589651c6cbc8, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\uC774\uC81C\uBD80\uD130\uB294 \uC7AC\uBBF8\uB098\uAC8C \uC0B4\uC544\uBCF4\uC790 "
