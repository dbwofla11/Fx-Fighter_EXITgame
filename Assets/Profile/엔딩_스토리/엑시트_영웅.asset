  m_Script: {fileID: 11500000, guid: e156c6d0f00000342bfe5645c848b686, type: 3}
  m_Name: "\uC5D1\uC2DC\uD2B8_\uC601\uC6C5"
  m_EditorClassIdentifier: Assembly-CSharp::StoryBeatSetSO
  beats:
  - background: {fileID: -3373147437577035260, guid: 87b4074a96ccd3f4daef4a9786295023, type: 3}
    speaker: "\uC5EC\uB3D9\uC0DD"
    line: "\"\uBBF8\uCCE4\uB2E4... \uC9C4\uC9DC \uBBF8\uCCE4\uC5B4. \uB0B4\uAC00
      \uBC29\uC1A1\uC5D0\uC11C \uC18C\uAC1C\uD588\uB358\n \uADF8 \uCF54\uC778\uC774
      \uC9C0\uAE08 \uC804 \uC138\uACC4\uC5D0\uC11C \uC81C\uC77C \uD56B\uD55C \uCF54\uC778\uC774
      \uB410\uB2E4\uACE0!\""
  - background: {fileID: -3028407511065196692, guid: ce3c06a453f545b468da92c885d5fc84, type: 3}
    speaker: "\uC5EC\uB3D9\uC0DD"
    line: "\"\uC790, \uC7A0\uAE50\uB9CC... \uC774\uAC70 \uBB50\uC57C. \uBC29\uAE08\uAE4C\uC9C0
      \uC624\uB974\uACE0 \uC788\uC5C8\uC796\uC544. \n\uC65C \uAC11\uC790\uAE30...
      \uC65C \uAC11\uC790\uAE30 \uC774\uB798?\""
  - background: {fileID: -1084611895696448309, guid: 2f85443d40410fc40995e70d05065365, type: 3}
    speaker: "\uC5EC\uB3D9\uC0DD"
    line: "\"\uB098\uB3C4 \uBAB0\uB790\uC5B4! \uB098\uB3C4 \uC774 \uCF54\uC778 \uC0C0\uB2E4\uACE0!
      \n\uB098\uB294... \uB098\uB3C4 \uD53C\uD574\uC790\uC57C, \uC81C\uBC1C...\""
  - background: {fileID: 4513544251747014989, guid: 2c70ece097cbfb84fb79046224abbddc, type: 3}
    speaker: "\uB098\uB798\uC774\uC158"
    line: "\"\uB354 \uC774\uC0C1 \uD560 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \n\uCE74\uBA54\uB77C
      \uC55E\uC5D0 \uC549\uC544 \uC788\uB294 \uAC83\uC870\uCC28, \uC228 \uC26C\uB294
      \uAC83\uC870\uCC28 \uBC84\uAC70\uC6E0\uB2E4.\""
  - background: {fileID: -7046376736601078521, guid: fdeadb50d296de9489b9589651c6cbc8, type: 3}
    speaker: "\uB098\uB798\uC774\uC158 "
    line: "\"\uAD6C\uB3C5\uC790 \uB9CC \uBA85. \uADF8 \uC5BC\uAD74\uB4E4\uC774 \uD558\uB098\uD558\uB098
      \uB5A0\uC62C\uB790\uB2E4. \n\uADF8\uB9AC\uACE0 \uD1B5\uC7A5\uC5D0 \uB0A8\uC740
      \uC22B\uC790, 0.\""
  - background: {fileID: 694026564983928263, guid: 3e63ce5083db80c4e93a4e945e61de4a, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\"\uD574\uB0C8\uB2E4. \uC644\uBCBD\uD558\uAC8C. \uC544\uBB34\uB3C4 \uB0A0
      \uBABB \uCC3E\uC544. \n\uC774\uC81C \uC5EC\uAE30\uC11C, \uD3C9\uC0DD \uC774\uB807\uAC8C
      \uC0B4\uBA74 \uB418\uB294 \uAC70\uC57C.\""
  - background: {fileID: -5427830894759728004, guid: acc2874a0e9ca364ca4219d2a9b59059, type: 3}
    speaker: "\uC8FC\uC778\uACF5"
    line: "\"\uC7A0\uAE50, \uC800 \uBAA9\uC18C\uB9AC... \uC5B4\uB514\uC11C \uB9CE\uC774
      \uB4E4\uC5B4\uBCF8 \uAC83 \uAC19\uC740\uB370.\""
  - background: {fileID: 8214906014133080317, guid: b3865009412121f4e80e575958106452, type: 3}
    speaker: "\uC8FC\uC778\uACF5 "
    line: "\"\uBB50\uB77C\uACE0...? \uC544\uB2C8\uC57C, \uC774\uB7F4 \uB9AC\uAC00...
      \uB0B4 \uB3D9\uC0DD\uC774 \uC65C \uC800\uAE30 \uB098\uC640.\""
